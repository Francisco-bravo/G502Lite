<Window x:Class="G502Lite.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="G502 Lite" Width="1040" Height="930" MinWidth="880" MinHeight="680" Background="#0B1020" Foreground="#EDF4FF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#98A9C4"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#202D46"/><Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.36"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#61E8F0"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1426"/><Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="CaretBrush" Value="#61E8F0"/><Setter Property="BorderBrush" Value="#34445D"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="17"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101A2C"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="10,9"/><Setter Property="MinWidth" Value="160"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#141E32"/><Setter Property="BorderBrush" Value="#26334B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/></Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid Margin="32,25,32,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="G502 LITE" FontSize="27" FontWeight="Bold"/><TextBlock Text="Control directo. Solo lo esencial." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#98A9C4" Margin="0,0,9,0"/><TextBlock x:Name="ConnectionLabel" Text="Desconectado" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,18,0"/><Button x:Name="ButtonsButton" Content="Botones" Click="Buttons_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ConnectButton" Content="Conectar" Click="Connect_Click"/><Button x:Name="RefreshButton" Content="↻  Actualizar" Margin="8,0,0,0" Click="Refresh_Click" IsEnabled="False"/></StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,20" Padding="24,20">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="DISPOSITIVO USB" FontSize="11" FontWeight="SemiBold" Foreground="#61E8F0"/><TextBlock x:Name="ModelText" Text="G502 HERO K/DA" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="ModeText" Text="Conecta el mouse para leer su estado." Style="{StaticResource Caption}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="30,0,38,0" VerticalAlignment="Center"><TextBlock Text="DPI ACTUAL" Style="{StaticResource Caption}"/><TextBlock x:Name="CurrentDpiText" Text="—" FontSize="34" FontWeight="Light" Foreground="#61E8F0"/></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="RESPUESTA" Style="{StaticResource Caption}"/><TextBlock x:Name="CurrentRateText" Text="—" FontSize="25" FontWeight="Light" Margin="0,5,0,0"/></StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel><TextBlock Text="Sensibilidad" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Ajusta la velocidad del cursor desde el sensor." Style="{StaticResource Caption}" Margin="0,7,0,20"/>
                        <TextBlock Text="DPI" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="DpiInput" Text="" IsEnabled="False" AutomationProperties.Name="DPI deseado"/><TextBlock x:Name="DpiRangeText" Text="El rango se obtiene del dispositivo." Style="{StaticResource Caption}" Margin="0,7,0,15"/>
                        <WrapPanel x:Name="QuickDpiPanel" Margin="0,0,0,15" IsEnabled="False"><Button Content="1200" Tag="1200" Click="QuickDpi_Click" Padding="13,9" Margin="0,0,7,7"/><Button Content="2400" Tag="2400" Click="QuickDpi_Click" Padding="13,9" Margin="0,0,7,7"/><Button Content="3200" Tag="3200" Click="QuickDpi_Click" Padding="13,9" Margin="0,0,7,7"/><Button Content="6400" Tag="6400" Click="QuickDpi_Click" Padding="13,9" Margin="0,0,7,7"/></WrapPanel>
                        <Button x:Name="ApplyDpiButton" Content="Aplicar DPI" Background="#61E8F0" Foreground="#0B1020" Click="ApplyDpi_Click" IsEnabled="False" HorizontalAlignment="Left"/>
                        <Border Background="#0E1728" CornerRadius="8" Padding="12" Margin="0,23,0,0"><StackPanel><TextBlock Text="Lectura del dispositivo" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="DpiLevelsText" Text="Niveles: —" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="#0E1728" CornerRadius="8" Padding="12" Margin="0,14,0,0"><StackPanel>
                            <TextBlock Text="PRUEBA DE BOTONES" FontSize="11" FontWeight="SemiBold" Foreground="#74F59C"/>
                            <TextBlock x:Name="ActivityText" Text="Pulsa un botón del mouse…" TextWrapping="Wrap" FontSize="15" Foreground="#61E8F0" Margin="0,8,0,7"/>
                            <TextBlock Text="Clics, rueda, multimedia y atajos del G502. No bloquea las acciones. Las funciones internas de DPI no envían una pulsación a Windows." Style="{StaticResource Caption}" FontSize="11"/>
                        </StackPanel></Border>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Frecuencia de respuesta" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Opciones compatibles con el mouse conectado." Style="{StaticResource Caption}" Margin="0,7,0,16"/><ComboBox x:Name="RateCombo" IsEnabled="False" HorizontalAlignment="Left" AutomationProperties.Name="Frecuencia de respuesta"/><Button x:Name="ApplyRateButton" Content="Aplicar frecuencia" Click="ApplyRate_Click" HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Iluminación" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LightingHelpText" Text="La compatibilidad se comprueba al conectar." Style="{StaticResource Caption}" Margin="0,7,0,14"/>
                            <ComboBox x:Name="LightingModeCombo" SelectedIndex="0" SelectionChanged="LightingMode_Changed" IsEnabled="False" AutomationProperties.Name="Modo de iluminación">
                                <ComboBoxItem Content="Color fijo"/>
                                <ComboBoxItem x:Name="CycleModeItem" Content="Multicolor gradual"/>
                                <ComboBoxItem Content="Apagado"/>
                            </ComboBox>
                            <StackPanel x:Name="ColorSettingsPanel" Margin="0,14,0,0">
                                <TextBlock Text="Color hexadecimal" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ColorInput" Text="#61E8F0" IsEnabled="False" AutomationProperties.Name="Color hexadecimal"/>
                            </StackPanel>
                            <StackPanel x:Name="CycleSettingsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                <Border Height="8" CornerRadius="4" Margin="0,0,0,12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF4D6D" Offset="0"/><GradientStop Color="#FFD166" Offset="0.17"/><GradientStop Color="#74F59C" Offset="0.33"/><GradientStop Color="#61E8F0" Offset="0.5"/><GradientStop Color="#7D8CFF" Offset="0.67"/><GradientStop Color="#E0A3D4" Offset="0.83"/><GradientStop Color="#FF4D6D" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <TextBlock Text="Duración de la vuelta completa (segundos)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CycleSecondsInput" Text="8" AutomationProperties.Name="Duración del ciclo multicolor en segundos"/>
                                <TextBlock Text="De 1 a 60 segundos. Recorre los colores con una transición suave y continua." Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Button x:Name="ApplyLightingButton" Content="Aplicar iluminación" Background="#E0A3D4" Foreground="#161123" Click="ApplyLighting_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Text="Listo para conectar." TextWrapping="Wrap" FontSize="13"/><TextBlock x:Name="GHubWarningText" Text="G HUB está ejecutándose y puede volver a aplicar sus ajustes." TextWrapping="Wrap" Foreground="#F3BD7D" Margin="0,7,0,0" Visibility="Collapsed"/>
            <Button x:Name="RecoverButtonsButton" Content="Recuperar botones" Click="RecoverButtons_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Recargar la configuración activa del mouse sin reescribir la memoria. Úsalo si las asignaciones guardadas dejan de responder tras una desconexión USB."/>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox x:Name="StartupCheckBox" Content="Iniciar con Windows en la bandeja" Foreground="#CED9EB" VerticalAlignment="Center" Checked="Startup_Changed" Unchecked="Startup_Changed" ToolTip="Al iniciar sesión se mostrará solo el icono de G502 Lite. Puedes desactivarlo aquí."/>
                <TextBlock Grid.Column="1" Text="Local · Sin cuenta · Sin telemetría" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,16,0" FontSize="11"/>
                <Button Grid.Column="2" x:Name="HideToTrayButton" Content="A la bandeja" Click="HideToTray_Click" Padding="12,7" ToolTip="Ocultar la ventana. Clic derecho para abrir el menú de bandeja con la opción Salir."/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
